# decision-agent-lab — API keys
# 이 파일을 .env 로 복사해서 키를 채우세요. .env 는 git 에 올라가지 않습니다.
#   cp .env.example .env

# ===== 필수 =====
# OpenAI: 생성 LLM(gpt-6-luna), LLM 판정자 베이스라인, 임베딩, OpenAI Decisions API(gpt-6-luna)
OPENAI_API_KEY=

# TypeSafe AI: Jev 결정 모델  (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=

# jevstation.com 중계 키(선택, 파일럿 전용): 신규 가입 시 무료 50크레딧. 응답 모델은 jev-1.13.0 고정이고 호출당 1크레딧입니다.
JEVSTATION_API_KEY=

# ===== 선택 =====
# Upstage Solar Decide  (https://console.upstage.ai  → API Keys)
UPSTAGE_API_KEY=

# OpenRouter (선택, 대체 경로): TypeSafe 신규 가입이 막혀 있으면 typesafe/jev-1.13, typesafe/jev-1.14 를
# 같은 가격($0.042/M)으로 쓸 수 있습니다. upstage/solar-decide, openai/gpt-6-luna-decisions 도 제공.
OPENROUTER_API_KEY=

# 로컬 결정 모델 (Ollama >= 0.35, /v1/systemone). 키 불필요. 켜려면 주석 해제.
# OLLAMA_BASE_URL=http://localhost:11434
